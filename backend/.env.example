# Copy to .env and adjust as needed.
DATABASE_URL=postgresql+psycopg2://localhost:5432/speak
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Phoneme recognizer: wav2vec2 (default, accurate) or allosaurus (lighter).
RECOGNIZER=wav2vec2
WAV2VEC2_MODEL=facebook/wav2vec2-lv-60-espeak-cv-ft
ALLOSAURUS_LANG=eng
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Noise reduction + loudness recovery (ffmpeg). Set DENOISE=false to disable.
# afftdn (tn=1) tracks changing background noise; speechnorm lifts quiet/fading
# speech so the end of a sentence stays audible to the recognizer.
DENOISE=true
AUDIO_FILTER=highpass=f=80,afftdn=nr=20:nf=-30:tn=1,speechnorm=e=12.5:r=0.0005:l=1
# Same denoise WITHOUT speechnorm — used only to measure the volume envelope, so
# an end-of-sentence fade is still visible instead of being normalized away.
ENVELOPE_FILTER=highpass=f=80,afftdn=nr=20:nf=-30:tn=1

# Where per-attempt analysis logs (expected vs. heard phones) are appended.
LOG_DIR=logs
